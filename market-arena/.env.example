# Your TypeSafe API key (console.typesafe.ai/keys). Never commit the real .env file.
TYPESAFE_API_KEY=
# Optional: players must enter this code before a round runs. Recommended for any public deployment.
ARENA_CODE=
# Optional: pin a model version instead of the moving alias, e.g. jev-1.13.0
TYPESAFE_MODEL=jev-latest

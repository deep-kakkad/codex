{
  "name": "proofwork",
  "version": "0.1.0",
  "private": true,
  "description": "Practical, scenario-based hiring assessments that are reviewed by people and verified live, not policed by proctoring.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx --watch-path=server --watch-path=shared server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx server/seed.ts",
    "migrate": "node --disable-warning=ExperimentalWarning --import tsx server/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^11.1.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "serverless-http": "^4.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@netlify/functions": "^6.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
